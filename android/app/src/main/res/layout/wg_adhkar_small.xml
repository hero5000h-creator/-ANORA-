<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget, short size (no source line): the dhikr due now in the adhkar screen's look (night sky, Amiri, gold) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wg_bg"
    android:layoutDirection="rtl"
    android:paddingStart="14dp"
    android:paddingTop="11dp"
    android:paddingEnd="14dp"
    android:paddingBottom="11dp">

    <LinearLayout
        android:id="@+id/wgBody"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layoutDirection="rtl"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layoutDirection="rtl"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/wgIcon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/wg_tile"
                android:contentDescription="@null"
                android:padding="6dp"
                android:src="@drawable/wg_ic_sab" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/wgTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/amiri_bold"
                    android:gravity="start"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="أذكار الصباح"
                    android:textColor="#FFF3E3BF"
                    android:textDirection="rtl"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/wgSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:gravity="start"
                    android:maxLines="1"
                    android:text="٠ من ١٦ · بعد الفجر حتى الضحى"
                    android:textColor="#B8EAE6DC"
                    android:textDirection="rtl"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/wgOpen"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="افتح أنورا"
                android:padding="8dp"
                android:src="@drawable/wg_star" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/wgBar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="7dp"
            android:max="16"
            android:progress="0"
            android:progressDrawable="@drawable/wg_bar" />

        <TextView
            android:id="@+id/wgText"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="2dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="19sp"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:fontFamily="@font/amiri_bold"
            android:gravity="center"
            android:lineSpacingMultiplier="1.15"
            android:maxLines="2"
            android:shadowColor="#99000000"
            android:shadowDy="2"
            android:shadowRadius="10"
            android:text="أَصْبَحْنَا وَأَصْبَحَ الْمُلْكُ لِلَّهِ، وَالْحَمْدُ لِلَّهِ"
            android:textColor="#FFF5F1E8"
            android:textDirection="rtl" />



        <!-- the widget's two shortcuts: the next prayer and "carry on reading" -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layoutDirection="rtl"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/wgPray"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/wg_pill"
                android:gravity="center"
                android:layoutDirection="rtl"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/wg_ic_clock" />

                <TextView
                    android:id="@+id/wgPrayT"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="مواقيت الصلاة"
                    android:textColor="#FFEAE6DC"
                    android:textDirection="rtl"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/wgRead"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/wg_pill_gold"
                android:gravity="center"
                android:layoutDirection="rtl"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/wg_ic_book" />

                <TextView
                    android:id="@+id/wgReadT"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="افتح المصحف"
                    android:textColor="#FFF3E3BF"
                    android:textDirection="rtl"
                    android:textSize="12.5sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
