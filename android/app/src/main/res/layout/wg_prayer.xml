<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen prayer times, tall size: the next prayer, the time left, and the day's five prayers -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wg_bg"
    android:layoutDirection="rtl"
    android:padding="14dp">

    <LinearLayout
        android:id="@+id/pBody"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layoutDirection="rtl"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layoutDirection="rtl"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/wg_tile"
                android:contentDescription="@null"
                android:padding="7dp"
                android:src="@drawable/wg_ic_sal" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/pTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/amiri_bold"
                    android:gravity="start"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="صلاة العصر"
                    android:textColor="#FFF3E3BF"
                    android:textDirection="rtl"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/pSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:gravity="start"
                    android:maxLines="1"
                    android:text="بغداد · الجعفري"
                    android:textColor="#B8EAE6DC"
                    android:textDirection="rtl"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/pOpen"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="افتح أنورا"
                android:padding="8dp"
                android:src="@drawable/wg_star" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pMid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:layoutDirection="rtl"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pBig"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:shadowColor="#99000000"
                android:shadowDy="2"
                android:shadowRadius="10"
                android:text="٣:١٥"
                android:textColor="#FFF5F1E8"
                android:textSize="36sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="1dp"
                android:layout_height="34dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="#47D9B46C"
                android:contentDescription="@null" />

            <LinearLayout
                android:id="@+id/pLeftBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/pIn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="باقي"
                    android:textColor="#B3EAE6DC"
                    android:textSize="11sp" />

                <Chronometer
                    android:id="@+id/pLeft"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:includeFontPadding="false"
                    android:textColor="#FFF0C98A"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pRow"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:layoutDirection="rtl"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/pc0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/wg_cell"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/pn0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="الفجر"
                    android:textColor="#B3EAE6DC"
                    android:textSize="10.5sp" />

                <TextView
                    android:id="@+id/pt0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="٤:٤٨"
                    android:textColor="#FFF5F1E8"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/pc1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/wg_cell"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/pn1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="الظهر"
                    android:textColor="#B3EAE6DC"
                    android:textSize="10.5sp" />

                <TextView
                    android:id="@+id/pt1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="١٢:٠٤"
                    android:textColor="#FFF5F1E8"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/pc2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/wg_cell_on"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/pn2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="العصر"
                    android:textColor="#B3EAE6DC"
                    android:textSize="10.5sp" />

                <TextView
                    android:id="@+id/pt2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="٣:١٥"
                    android:textColor="#FFF5F1E8"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/pc3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/wg_cell"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/pn3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="المغرب"
                    android:textColor="#B3EAE6DC"
                    android:textSize="10.5sp" />

                <TextView
                    android:id="@+id/pt3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="٥:٠٢"
                    android:textColor="#FFF5F1E8"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/pc4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/wg_cell"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/pn4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="العشاء"
                    android:textColor="#B3EAE6DC"
                    android:textSize="10.5sp" />

                <TextView
                    android:id="@+id/pt4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="٦:٢١"
                    android:textColor="#FFF5F1E8"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
