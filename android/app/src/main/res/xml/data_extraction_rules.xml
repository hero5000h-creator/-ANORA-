<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: the same as backup_rules.xml, for cloud backup and phone-to-phone transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="audio" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="audio" />
    </device-transfer>
</data-extraction-rules>
